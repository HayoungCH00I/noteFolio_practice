{
  "name": "vs-code",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-choir-audio.mjs",
    "dev": "vite",
    "certs": "node scripts/setup-dev-https.mjs",
    "certs:clients": "node scripts/package-https-clients.mjs",
    "prebuild": "node scripts/prepare-choir-audio.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:claw": "node --test tests/claw-game.test.mjs",
    "company": "npm run build && node server/company-server.mjs",
    "test:company": "node --test tests/company-room.test.mjs tests/company-camera.test.mjs",
    "test:fruit": "node --test tests/fruit-game.test.mjs tests/fruit-camera.test.mjs tests/fruit-tracker.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:snow": "node --test tests/snow-physics.test.mjs tests/snow-interactions.test.mjs",
    "test:choir": "node --test tests/choir-*.test.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "@soundtouchjs/audio-worklet": "2.1.1",
    "cannon-es": "^0.20.0",
    "pbf": "^5.2.0",
    "three": "^0.187.0",
    "ws": "^8.22.1"
  }
}
